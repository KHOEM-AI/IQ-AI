{
  "name": "iq-ai",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server/server.mjs",
    "test": "node --test tests/*.test.mjs src/tests/*.test.mjs",
    "build:native": "cmake -S native/cpp -B native/cpp/build -DCMAKE_BUILD_TYPE=Release && cmake --build native/cpp/build --parallel 2",
    "test:native": "npm run build:native && node --test tests/cppEngine.test.mjs tests/audioNativeIntegration.test.mjs"
  }
}
